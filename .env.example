# Copia este archivo como ".env" (mismo nivel, junto a este ejemplo) y
# completa los datos reales de tu hosting. El archivo ".env" NUNCA se sube
# al repositorio (ver .gitignore) ni se sirve por HTTP (ver .htaccess).
#
# Si no existe un .env, config/db.php usa valores por defecto pensados
# para XAMPP en local (127.0.0.1 / lirios / root / sin contraseña).

DB_HOST=127.0.0.1
DB_NAME=lirios
DB_USER=root
DB_PASS=

# Aviso por correo de "pedido nuevo" (config/mailer.php, ver api/pedidos.php).
# Si SMTP_USER, SMTP_PASS o NOTIFICACION_EMAIL quedan vacíos, simplemente no
# se envía ningún correo (el pedido y el WhatsApp siguen funcionando igual).
#
# SMTP_USER / SMTP_PASS: cuenta de Gmail remitente y su "contraseña de
# aplicación" de 16 caracteres (myaccount.google.com/apppasswords, requiere
# verificación en 2 pasos activada) — NUNCA la contraseña normal de Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICACION_EMAIL=Aldonoeperezmoreno2@gmail.com
